# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database
/prisma/*.db
/prisma/*.db-journal
# a copy of the local database's rows (employees, password hashes): never committed
/local-backup/

# user-uploaded content
/public/uploads

# iOS — generated by `xcodegen generate` (CI regenerates these itself)
/ios/NeonAdmin.xcodeproj
/ios/Info.plist
/ios/build
/ios/build-device
/ios/buildsim
/ios/Payload
/ios/*.ipa
# Generated by xcodegen from ios/project.yml, like Info.plist.
ios/NeonAdmin.entitlements
ios/NeonShare.entitlements
/ios/NeonShare-Info.plist

# The camera relay's own file: hand-written cameras with their passwords, and the
# names go2rtc keeps connected. Never committed (deploy/go2rtc/README.md).
/deploy/go2rtc/go2rtc.yaml

# The deploy stamp the Dockerfile writes inside the image (next.config.ts).
# A copy here would be a stale id handed to every local build.
/.deploy-id
