{
  "name": "nexora-whatsapp",
  "version": "1.0.0",
  "description": "A WhatsApp number run properly: sessions that survive WhatsApp Web, and a send queue that will not get the number restricted.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/ts-hook.mjs scripts/smoke-test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "peerDependencies": {
    "puppeteer": ">=22"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.2"
  },
  "license": "Apache-2.0",
  "private": true
}
