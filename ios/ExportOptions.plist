<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight and, later, an Apple Business Manager Custom App. Never a
	     public App Store listing: review needs a demo account, which would
	     expose the studio's real payroll, attendance and chat. -->
	<key>method</key>
	<string>app-store-connect</string>
	<!-- Straight to App Store Connect, where it appears in TestFlight once
	     Apple has processed it. -->
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>745F9U99BC</string>
	<!-- Xcode makes and refreshes the distribution profile itself. -->
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
