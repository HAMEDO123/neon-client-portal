<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- "%d line items" — the Pricing total's line count. Plain %d
         substitution read "1 line items" in English and, worse, used the
         same Arabic word for 3 as for 300 ("%d بند"), which is wrong for
         3–10 (بنود) and for 11–99 (بندًا). Verified against a standalone
         Bundle + stringsdict pair before landing this (macOS swiftc, no
         simulator or server involved), so the plural category actually
         selected for 0/1/2/3/11/100 is confirmed, not assumed. -->
    <key>%d line items</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>لا بنود</string>
            <key>one</key>
            <string>بند واحد</string>
            <key>two</key>
            <string>بندان</string>
            <key>few</key>
            <string>%d بنود</string>
            <key>many</key>
            <string>%d بندًا</string>
            <key>other</key>
            <string>%d بند</string>
        </dict>
    </dict>
</dict>
</plist>
