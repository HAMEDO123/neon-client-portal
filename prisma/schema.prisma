generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PublishState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Admin-facing pipeline label shown as a status pill on the project cover.
enum PipelineStatus {
  DRAFT
  INTERNAL_REVIEW
  SENT_TO_CLIENT
  CLIENT_REVIEWING
  CHANGES_REQUESTED
  APPROVED
  EXECUTION
  COMPLETED
  ARCHIVED
}

// Drives the visual journey timeline on the client page.
enum ProjectStage {
  CONCEPT
  DESIGN
  VISUALIZATION
  TECHNICAL_DRAWINGS
  BOQ
  PRICING
  APPROVAL
  HANDOVER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum CommentAuthor {
  CLIENT
  ADMIN
}

enum CommentStatus {
  OPEN
  RESOLVED
}

// State of one cell in the daily task board (project x process task).
// TODO / IN_PROGRESS / DONE are the employee-facing execution statuses
// (Pending / In Progress / Completed); TOMORROW is the admin board's existing
// "deferred to tomorrow" marker and doubles as a scheduling signal.
enum TaskState {
  TODO
  IN_PROGRESS
  // Finished as far as the employee is concerned, with a photo attached,
  // waiting for the manager to look at it. Only the manager moves it to DONE.
  SUBMITTED
  DONE
  TOMORROW
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// What the manager gets told about, as it happens.
enum AdminNotificationType {
  TASK_SUBMITTED
  TASK_STATUS_CHANGED
  TASK_OVERDUE
  SUPPLY_REQUEST
  CHAT_MESSAGE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_TODAY_SCHEDULE
  TASK_TOMORROW_SCHEDULE
  TASK_DEADLINE_REMINDER
  CHAT_MESSAGE
  SYSTEM_NOTIFICATION
}

enum PayBasis {
  MONTHLY
  WEEKLY
}

enum SupplyRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PURCHASED
}

enum ReceiptStatus {
  PENDING
  ANALYZED
  FAILED
}

enum ChatAuthorType {
  ADMIN
  EMPLOYEE
  AGENT
}

enum ChatMessageKind {
  TEXT
  IMAGE
  FILE
  VOICE
}

enum DeliveryChannel {
  IN_APP
  WEB_PUSH
}

enum DeliveryStatus {
  CREATED
  SENT
  FAILED
  EXPIRED
}

model Project {
  id          String  @id @default(cuid())
  token       String  @unique
  name        String
  clientName  String
  clientEmail String?
  clientPhone String?

  location    String?
  area        String?
  projectType String?
  description String? @db.Text

  coverImageUrl String?
  deliveryDate  DateTime?

  publishState      PublishState   @default(DRAFT)
  pipelineStatus    PipelineStatus @default(DRAFT)
  currentStage      ProjectStage   @default(CONCEPT)
  completionPercent Int            @default(0)

  // Client-visibility settings (item 13 / 47 / 26 of the spec).
  showPricing         Boolean @default(false)
  showDetailedPricing Boolean @default(true)
  showBoqQuantities   Boolean @default(true)
  showBoqPrices       Boolean @default(false)
  allowDownloads      Boolean @default(true)
  watermarkEnabled    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spaces       GallerySpace[]
  drawings     Drawing[]
  documents    Document[]
  boqItems     BoqItem[]
  pricingItems PricingItem[]
  materials    Material[]
  furniture    FurnitureItem[]
  approvals    Approval[]
  comments     Comment[]
  activities   ProjectActivity[]
  taskEntries  ProjectTaskEntry[]
  chatMessages ChatMessage[]
  sectionTeam  ProjectSectionAssignment[]
}

model GallerySpace {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name  String
  order Int    @default(0)

  images GalleryImage[]
}

model GalleryImage {
  id      String       @id @default(cuid())
  spaceId String
  space   GallerySpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  imageUrl       String
  caption        String?
  isBeforeAfter  Boolean  @default(false)
  beforeImageUrl String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  hotspots ImageHotspot[]
}

model ImageHotspot {
  id      String       @id @default(cuid())
  imageId String
  image   GalleryImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  xPercent    Float
  yPercent    Float
  label       String
  description String?
  category    String?
  linkLabel   String?
  order       Int     @default(0)
}

model Drawing {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category      String
  subCategory   String?
  name          String
  drawingNumber String?
  revision      String  @default("R00")
  fileUrl       String
  thumbnailUrl  String?
  fileType      String
  fileSize      Int?
  order         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions DrawingRevision[]
}

model DrawingRevision {
  id        String  @id @default(cuid())
  drawingId String
  drawing   Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  revision  String
  note      String?
  fileUrl   String
  createdAt DateTime @default(now())
}

model Document {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category  String
  title     String
  fileUrl   String
  fileType  String
  fileSize  Int?
  version   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model BoqItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category       String
  name           String
  description    String?
  specification  String?
  unit           String
  quantity       Float
  unitPrice      Float?
  imageUrl       String?
  relatedDrawing String?
  relatedSpace   String?
  notes          String?
  order          Int     @default(0)
}

model PricingItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category    String
  label       String
  description String?
  amount      Float
  isOptional  Boolean @default(false)
  order       Int     @default(0)
}

model Material {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category      String
  name          String
  brand         String?
  model         String?
  color         String?
  finish        String?
  specification String?
  supplier      String?
  reference     String?
  imageUrl      String?
  estimatedQty  String?
  price         Float?
  relatedSpaces String?
  order         Int     @default(0)
}

model FurnitureItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name       String
  brand      String?
  model      String?
  dimensions String?
  quantity   Int     @default(1)
  finish     String?
  supplier   String?
  reference  String?
  imageUrl   String?
  price      Float?
  space      String?
  order      Int     @default(0)
}

model Approval {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  itemLabel   String
  status      ApprovalStatus @default(PENDING)
  clientName  String?
  note        String?
  respondedAt DateTime?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
}

model Comment {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorName String
  authorType CommentAuthor @default(CLIENT)
  message    String        @db.Text
  refLabel   String?
  status     CommentStatus @default(OPEN)
  createdAt  DateTime      @default(now())
}

model ProjectActivity {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type      String
  detail    String?
  createdAt DateTime @default(now())
}

// A member of the NEON team. Owns a slice of the shared delivery process, and
// gets one column group on the task board.
model Employee {
  id     String  @id @default(cuid())
  name   String
  // Job title shown on the board ("3D Visualizer") — not an access role.
  role   String?
  // Accent used for this employee's column group on the board.
  color  String  @default("cyan")
  order  Int     @default(0)
  // Doubles as the account status: a disabled employee cannot sign in.
  active Boolean @default(true)

  // Sign-in details. Null until the admin gives this person an account, so
  // people added to the board before employee accounts existed still work.
  email        String?   @unique
  passwordHash String?
  phone        String?
  employeeCode String?   @unique
  // Only one access role exists today; the column keeps the check explicit
  // and leaves room for another role later.
  accessRole   String    @default("EMPLOYEE")
  lastLoginAt  DateTime?

  // Payroll. The amount is per pay period: a month for monthly staff, a week
  // for weekly staff, which is what decides the hourly divisor.
  salaryAmount Float?
  payBasis     PayBasis @default(MONTHLY)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tasks           ProcessTask[]
  assignedEntries ProjectTaskEntry[]         @relation("EntryAssignee")
  notifications   Notification[]
  subscriptions   PushSubscription[]
  preference      NotificationPreference?
  chatMessages    ChatMessage[]
  chatReads       ChatRead[]
  supplyRequests  SupplyRequest[]
  submissions     TaskSubmission[]
  receipts        ExpenseReceipt[]
  attendance      AttendanceRecord[]
  adminAlerts     AdminNotification[]        @relation("AdminNotificationSubject")
  adjustments     SalaryAdjustment[]
  assignedTasks   AssignedTask[]
  sectionWork     ProjectSectionAssignment[]
}

// One step of the delivery process. The process is identical for every project,
// so these are defined once and every project inherits the whole list.
model ProcessTask {
  id         String    @id @default(cuid())
  name       String
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  order      Int       @default(0)

  // The part of the process this step belongs to — Site & Procurement, 3D
  // Visualization, Technical Drawings. Sections are what the board groups by
  // and what work is handed out in: a person takes a section of a project, not
  // sixteen separate steps.
  sectionId String?
  section   ProcessSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  periodsFrom StagePeriod[] @relation("PeriodFrom")
  periodsTo   StagePeriod[] @relation("PeriodTo")

  createdAt DateTime @default(now())

  entries ProjectTaskEntry[]
}

// The state of one process task on one project — a single cell of the board.
// Rows are created lazily: an untouched cell simply has no entry and reads TODO.
model ProjectTaskEntry {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String
  task      ProcessTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  state       TaskState @default(TODO)
  completedAt DateTime?
  startedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // An entry is normally worked by whoever owns the step; assigning one here
  // overrides that for this project without moving the whole column.
  assigneeId String?
  assignee   Employee? @relation("EntryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Scheduling and detail the employee portal needs. A day, not a timestamp:
  // "which day is this on" is a calendar question in the company timezone.
  scheduledFor DateTime?    @db.Date
  dueAt        DateTime?
  priority     TaskPriority @default(MEDIUM)
  adminNote    String?      @db.Text
  employeeNote String?      @db.Text

  // Some cells are not this person's score to keep: a step that turned out not
  // to apply to the project, or one somebody else absorbed. Excluded cells
  // still sit on the board and can still be ticked; they simply do not count
  // towards anyone's completion percentage.
  excludedFromProgress Boolean @default(false)

  notifications Notification[]
  submissions   TaskSubmission[]

  @@unique([projectId, taskId])
  @@index([taskId])
  @@index([assigneeId])
  @@index([scheduledFor])
}

// One notification for one employee. Everything an employee is told goes
// through here first, so the in-app centre and push are always consistent.
model Notification {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String           @db.Text

  entryId String?
  entry   ProjectTaskEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  // Where a click should land, resolved when the notification is created so
  // the service worker never has to know the routing rules.
  url      String?
  metadata Json?

  // Deterministic per logical event, so a job that runs twice writes once.
  dedupeKey String @unique

  readAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@index([employeeId, readAt])
  @@index([employeeId, createdAt])
}

// Per-employee switches the engine consults before sending anything.
model NotificationPreference {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  pushEnabled         Boolean @default(true)
  chatMessages        Boolean @default(true)
  taskAssigned        Boolean @default(true)
  taskUpdated         Boolean @default(true)
  todaySchedule       Boolean @default(true)
  tomorrowSchedule    Boolean @default(true)
  deadlineReminders   Boolean @default(true)
  // How far ahead of dueAt a reminder fires — configurable, not hardcoded.
  deadlineLeadMinutes Int     @default(120)

  updatedAt DateTime @default(now()) @updatedAt
}

// One row per device an employee has enabled push on.
model PushSubscription {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  endpoint     String  @unique
  p256dh       String
  auth         String
  userAgent    String?
  // Deactivated rather than deleted when the push service rejects it, so the
  // delivery log still points at something.
  active       Boolean @default(true)
  failureCount Int     @default(0)

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  deliveries NotificationDelivery[]

  @@index([employeeId, active])
}

// Delivery attempts, kept so push failures are debuggable after the fact.
model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   PushSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  channel DeliveryChannel
  status  DeliveryStatus
  detail  String?

  createdAt DateTime @default(now())

  @@index([notificationId])
}

// Small key/value store for platform settings such as the company timezone.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// The team conversation. One channel today — the whole team plus the manager —
// but modelled as a channel so a second one (per project, say) needs no
// migration later.
model ChatChannel {
  id   String @id @default(cuid())
  key  String @unique
  name String

  createdAt DateTime @default(now())

  messages ChatMessage[]
  reads    ChatRead[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  authorType ChatAuthorType
  // Set for employee messages; the manager and the agent have no Employee row.
  authorId   String?
  author     Employee?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String

  kind ChatMessageKind @default(TEXT)
  body String?         @db.Text

  attachmentUrl   String?
  attachmentName  String?
  attachmentType  String?
  attachmentSize  Int?
  // Voice notes only, so the player can show a length before loading.
  durationSeconds Int?

  // Optional context: which project this message is about.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // The assistant is the manager's tool, so its questions and answers stay out
  // of the team's view entirely rather than being hidden in the client.
  managerOnly Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([channelId, createdAt])
  @@index([channelId, managerOnly, createdAt])
}

// How far each person has read, for the unread badge.
model ChatRead {
  id        String      @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // The employee id, or "admin" for the manager, who has no Employee row.
  // A plain string rather than a nullable id because Postgres treats NULLs as
  // distinct — a nullable column in this unique would let duplicate rows
  // accumulate, and Prisma cannot address a null through a compound unique.
  readerKey String

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  lastReadAt DateTime @default(now())

  @@unique([channelId, readerKey])
}

// An employee asking for something to be bought for the office. The manager
// decides; nothing is ordered on an employee's say-so.
model SupplyRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  item          String
  quantity      String?
  note          String? @db.Text
  estimatedCost Float?
  urgent        Boolean @default(false)

  status       SupplyRequestStatus @default(PENDING)
  decisionNote String?
  decidedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([employeeId, createdAt])
}

// A receipt photo an employee spent their own money on ("salary++"). The
// amount the receipt shows and the amount that counts are stored separately:
// the company rule caps any single receipt at 2 JOD, and keeping the original
// means a disputed total can always be traced back to what was actually paid.
model ExpenseReceipt {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  imageUrl String
  status   ReceiptStatus @default(PENDING)

  // Filled in by the vision pass, and editable by the manager afterwards.
  vendor        String?
  receiptDate   DateTime?
  rawAmount     Float?
  countedAmount Float?
  currency      String    @default("JOD")
  summary       String?   @db.Text
  aiNotes       String?   @db.Text

  // The payroll month this belongs to, as YYYY-MM in the company timezone.
  periodMonth String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([employeeId, periodMonth])
  @@index([periodMonth, status])
}

// One day's lateness for one employee. Entered by the manager today; the
// attendance device can write the same rows later without changing anything
// downstream.
model AttendanceRecord {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  day        DateTime @db.Date
  delayHours Float    @default(0)
  note       String?
  // MANUAL for now; DEVICE once the attendance machine feeds this table.
  source     String   @default("MANUAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([employeeId, day])
  @@index([day])
}

// An employee's evidence that a task is done, and what the manager decided
// about it. Kept as rows rather than fields on the task so a rejected attempt
// and the resubmission that followed are both still there to look at.
model TaskSubmission {
  id      String            @id @default(cuid())
  entryId String?
  entry   ProjectTaskEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)

  // Or a job the manager handed out by hand. Exactly one of the two is set:
  // evidence is always for something, and the review has to know what it is
  // approving.
  assignedTaskId String?
  assignedTask   AssignedTask? @relation(fields: [assignedTaskId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // The proof itself — a photo of the work, or a screenshot.
  imageUrl String
  note     String? @db.Text

  status     SubmissionStatus @default(PENDING)
  reviewNote String?          @db.Text
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([entryId, createdAt])
  @@index([assignedTaskId, createdAt])
}

// The manager's own notification feed.
//
// Employees have Notification; this is the other direction — work coming back
// up. It is deliberately a separate table: there is one manager, no devices to
// fan out to and no preferences to consult, so none of the employee engine's
// machinery applies. The unique dedupeKey gives it the same idempotency.
model AdminNotification {
  id      String                @id @default(cuid())
  type    AdminNotificationType
  title   String
  message String                @db.Text
  url     String

  entryId    String?
  employeeId String?
  employee   Employee? @relation("AdminNotificationSubject", fields: [employeeId], references: [id], onDelete: SetNull)

  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
}

// A change to what someone is paid this period, with the reason attached.
//
// Amounts are signed the way payroll reads them: positive is money off. One row
// per employee per period per kind, so a monthly job that runs twice does not
// deduct twice.
model SalaryAdjustment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // "2026-09" for a month, "2026-W37" for a week.
  periodKey String
  kind      String
  amount    Float
  reason    String @db.Text

  createdAt DateTime @default(now())

  @@unique([employeeId, periodKey, kind])
  @@index([periodKey])
}

// A part of the delivery process, and the unit work is handed out in.
model ProcessSection {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)
  color String @default("cyan")

  createdAt DateTime @default(now())

  tasks       ProcessTask[]
  assignments ProjectSectionAssignment[]
}

// How long a run of steps is allowed to take.
//
// Deliberately a range rather than a number per step: nobody times a process
// one box at a time. "Site visit through BOQ is four days" is one decision, and
// every step inside the range shares the deadline it produces. Ranges chain —
// the next one starts when this one is finished — so the whole process has
// dates without anyone typing a date.
model StagePeriod {
  id String @id @default(cuid())

  fromTaskId String
  fromTask   ProcessTask @relation("PeriodFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTaskId   String
  toTask     ProcessTask @relation("PeriodTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  days Int

  createdAt DateTime @default(now())

  @@unique([fromTaskId, toTaskId])
}

// Who does a section of one project. The same section goes to different people
// on different jobs, which is why this hangs off the pair rather than off the
// section alone.
model ProjectSectionAssignment {
  id String @id @default(cuid())

  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId String
  section   ProcessSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([projectId, sectionId])
  @@index([employeeId])
}

// Work the manager hands out directly, outside the project process.
//
// "Go and negotiate with the supplier, two days" is not a stage of any project
// and has no cell on the board — it is a job for a person over a span of days,
// which is what the week view shows.
model AssignedTask {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title String
  note  String? @db.Text

  // Days, not timestamps: "Tuesday to Wednesday" is a calendar question in the
  // company timezone.
  startDay DateTime @db.Date
  endDay   DateTime @db.Date

  state       TaskState    @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  completedAt DateTime?

  submissions TaskSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([employeeId, startDay])
  @@index([startDay, endDay])
}
