generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PublishState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Admin-facing pipeline label shown as a status pill on the project cover.
enum PipelineStatus {
  DRAFT
  INTERNAL_REVIEW
  SENT_TO_CLIENT
  CLIENT_REVIEWING
  CHANGES_REQUESTED
  APPROVED
  EXECUTION
  COMPLETED
  ARCHIVED
}

// Drives the visual journey timeline on the client page.
enum ProjectStage {
  CONCEPT
  DESIGN
  VISUALIZATION
  TECHNICAL_DRAWINGS
  BOQ
  PRICING
  APPROVAL
  HANDOVER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum CommentAuthor {
  CLIENT
  ADMIN
}

enum CommentStatus {
  OPEN
  RESOLVED
}

// State of one cell in the daily task board (project x process task).
// TODO / IN_PROGRESS / DONE are the employee-facing execution statuses
// (Pending / In Progress / Completed); TOMORROW is the admin board's existing
// "deferred to tomorrow" marker and doubles as a scheduling signal.
enum TaskState {
  TODO
  IN_PROGRESS
  // Finished as far as the employee is concerned, with a photo attached,
  // waiting for the manager to look at it. Only the manager moves it to DONE.
  SUBMITTED
  DONE
  TOMORROW
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// What the manager gets told about, as it happens.
enum AdminNotificationType {
  TASK_SUBMITTED
  TASK_STATUS_CHANGED
  TASK_OVERDUE
  SUPPLY_REQUEST
  CHAT_MESSAGE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_TODAY_SCHEDULE
  TASK_TOMORROW_SCHEDULE
  TASK_DEADLINE_REMINDER
  CHAT_MESSAGE
  SYSTEM_NOTIFICATION
  // A formal warning from the manager. Preferences never silence it.
  WARNING
}

enum PayBasis {
  MONTHLY
  WEEKLY
}

enum SupplyRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PURCHASED
}

enum ReceiptStatus {
  PENDING
  ANALYZED
  FAILED
}

enum ChatAuthorType {
  ADMIN
  EMPLOYEE
  AGENT
}

enum ChatMessageKind {
  TEXT
  IMAGE
  FILE
  VOICE
  // A task the manager handed out from the chat; the card is its ChatTask.
  TASK
  // The line a call leaves when it ends: "Missed call", "Call ended · 4:32".
  CALL
  // A meeting the manager set from the chat; the card is its ChatMeeting.
  MEETING
}

enum MeetingMode {
  // Everybody joins from wherever they are, so the card carries a call button.
  ONLINE
  // In a room, on site, at the client's: the card carries the place instead.
  IN_PERSON
}

enum MeetingRsvp {
  // Asked, and has not said either way. Never read as a refusal: the platform
  // cannot tell somebody who will not come from somebody who has not looked.
  INVITED
  ACCEPTED
  DECLINED
}

enum CallKind {
  AUDIO
  VIDEO
}

enum CallStatus {
  // Asking the people in the conversation; nobody but the caller is in it yet.
  RINGING
  ACTIVE
  ENDED
}

enum CallParticipantState {
  INVITED
  JOINED
  LEFT
  DECLINED
}

enum DeliveryChannel {
  IN_APP
  WEB_PUSH
}

enum DeliveryStatus {
  CREATED
  SENT
  FAILED
  EXPIRED
}

model Project {
  id          String  @id @default(cuid())
  token       String  @unique
  name        String
  clientName  String
  clientEmail String?
  clientPhone String?

  location    String?
  area        String?
  projectType String?
  description String? @db.Text

  coverImageUrl String?
  deliveryDate  DateTime?

  // A project is a sale. Who sold it, and the day it counts for: the month of
  // soldOn is the month it counts towards that person's target (lib/sales.ts).
  soldById String?
  soldBy   Employee? @relation("ProjectSoldBy", fields: [soldById], references: [id], onDelete: SetNull)
  soldOn   DateTime? @db.Date

  publishState      PublishState   @default(DRAFT)
  pipelineStatus    PipelineStatus @default(DRAFT)
  currentStage      ProjectStage   @default(CONCEPT)
  completionPercent Int            @default(0)

  // Client-visibility settings (item 13 / 47 / 26 of the spec).
  showPricing         Boolean @default(false)
  showDetailedPricing Boolean @default(true)
  showBoqQuantities   Boolean @default(true)
  showBoqPrices       Boolean @default(false)
  allowDownloads      Boolean @default(true)
  watermarkEnabled    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spaces       GallerySpace[]
  drawings     Drawing[]
  documents    Document[]
  boqItems     BoqItem[]
  pricingItems PricingItem[]
  materials    Material[]
  furniture    FurnitureItem[]
  approvals    Approval[]
  comments     Comment[]
  activities   ProjectActivity[]
  taskEntries  ProjectTaskEntry[]
  chatMessages ChatMessage[]
  sectionTeam  ProjectSectionAssignment[]

  @@index([soldById, soldOn])
}

model GallerySpace {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name  String
  order Int    @default(0)

  images GalleryImage[]
}

model GalleryImage {
  id      String       @id @default(cuid())
  spaceId String
  space   GallerySpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  imageUrl       String
  caption        String?
  isBeforeAfter  Boolean  @default(false)
  beforeImageUrl String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  hotspots ImageHotspot[]
}

model ImageHotspot {
  id      String       @id @default(cuid())
  imageId String
  image   GalleryImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  xPercent    Float
  yPercent    Float
  label       String
  description String?
  category    String?
  linkLabel   String?
  order       Int     @default(0)
}

model Drawing {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category      String
  subCategory   String?
  name          String
  drawingNumber String?
  revision      String  @default("R00")
  fileUrl       String
  thumbnailUrl  String?
  fileType      String
  fileSize      Int?
  order         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions DrawingRevision[]
}

model DrawingRevision {
  id        String  @id @default(cuid())
  drawingId String
  drawing   Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  revision  String
  note      String?
  fileUrl   String
  createdAt DateTime @default(now())
}

model Document {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category  String
  title     String
  fileUrl   String
  fileType  String
  fileSize  Int?
  version   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model BoqItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category       String
  name           String
  description    String?
  specification  String?
  unit           String
  quantity       Float
  unitPrice      Float?
  imageUrl       String?
  relatedDrawing String?
  relatedSpace   String?
  notes          String?
  order          Int     @default(0)
}

model PricingItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category    String
  label       String
  description String?
  amount      Float
  isOptional  Boolean @default(false)
  order       Int     @default(0)
}

model Material {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category      String
  name          String
  brand         String?
  model         String?
  color         String?
  finish        String?
  specification String?
  supplier      String?
  reference     String?
  imageUrl      String?
  estimatedQty  String?
  price         Float?
  relatedSpaces String?
  order         Int     @default(0)
}

model FurnitureItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name       String
  brand      String?
  model      String?
  dimensions String?
  quantity   Int     @default(1)
  finish     String?
  supplier   String?
  reference  String?
  imageUrl   String?
  price      Float?
  space      String?
  order      Int     @default(0)
}

model Approval {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  itemLabel   String
  status      ApprovalStatus @default(PENDING)
  clientName  String?
  note        String?
  respondedAt DateTime?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
}

model Comment {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorName String
  authorType CommentAuthor @default(CLIENT)
  message    String        @db.Text
  refLabel   String?
  status     CommentStatus @default(OPEN)
  createdAt  DateTime      @default(now())
}

model ProjectActivity {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type      String
  detail    String?
  createdAt DateTime @default(now())
}

// A member of the NEON team. Owns a slice of the shared delivery process, and
// gets one column group on the task board.
model Employee {
  id     String  @id @default(cuid())
  name   String
  // Job title shown on the board ("3D Visualizer") — not an access role.
  role   String?
  // Accent used for this employee's column group on the board.
  color  String  @default("cyan")
  order  Int     @default(0)
  // Doubles as the account status: a disabled employee cannot sign in.
  active Boolean @default(true)

  // Sign-in details. Null until the admin gives this person an account, so
  // people added to the board before employee accounts existed still work.
  email        String?   @unique
  passwordHash String?
  phone        String?
  employeeCode String?   @unique
  // Only one access role exists today; the column keeps the check explicit
  // and leaves room for another role later.
  accessRole   String    @default("EMPLOYEE")
  lastLoginAt  DateTime?

  // Payroll. The amount is per pay period: a month for monthly staff, a week
  // for weekly staff, which is what decides the hourly divisor.
  salaryAmount Float?
  payBasis     PayBasis @default(MONTHLY)

  // Projects this person is expected to sell each calendar month.
  monthlySalesTarget Int @default(3)

  // What this person usually does, in the manager's own words: their trade,
  // what they are normally given, what they are never given, how much fits in
  // a day. Read when a day is proposed for them, so the suggestion follows how
  // the studio actually works rather than what a model guesses.
  playbook String? @db.Text

  // The rest of the profile a day is proposed from: what they can actually do,
  // work of theirs worth copying, and how much of a day is really theirs to
  // fill. The studio's hours say how long the day is; this says how much of it
  // to plan (`capacityFor` in lib/day-plan.ts), and it may only ever lower it.
  skills               String? @db.Text
  examples             String? @db.Text
  dailyCapacityMinutes Int?

  // Who this person's finished work goes to, where that is not the manager.
  reviewerId String?
  reviewer   Employee?  @relation("EmployeeReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewees  Employee[] @relation("EmployeeReviewer")

  // What the studio's own rules remember about this person, day by day.
  automationStates AutomationState[]
  // Their own account of each day, written by them for the manager.
  dailyReports     DailyReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tasks           ProcessTask[]
  // Steps whose finished work normally comes to this person rather than the
  // manager. Named, because there are now two ways to be attached to a step.
  reviewsSteps    ProcessTask[]              @relation("StepReviewer")
  assignedEntries ProjectTaskEntry[]         @relation("EntryAssignee")
  notifications   Notification[]
  subscriptions   PushSubscription[]
  preference      NotificationPreference?
  chatMessages    ChatMessage[]
  chatReads       ChatRead[]
  supplyRequests  SupplyRequest[]
  submissions     TaskSubmission[]
  receipts        ExpenseReceipt[]
  dayPlans        DayPlan[]
  followUps       ScheduledFollowUp[]
  attendance      AttendanceRecord[]
  adminAlerts     AdminNotification[]        @relation("AdminNotificationSubject")
  adjustments     SalaryAdjustment[]
  assignedTasks   AssignedTask[]
  sectionWork     ProjectSectionAssignment[]
  warnings        EmployeeWarning[]
  soldProjects    Project[]                  @relation("ProjectSoldBy")
  // Work waiting on this person to unstick it.
  blockedEntries  ProjectTaskEntry[]         @relation("EntryBlockedBy")
  blockedJobs     AssignedTask[]             @relation("JobBlockedBy")
}

// A formal warning from the manager, with the reason the employee is shown at
// the top of their home screen. The third closes the account (lib/warnings.ts);
// one given by mistake is removed by deleting it.
model EmployeeWarning {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  reason    String   @db.Text
  createdAt DateTime @default(now())

  @@index([employeeId, createdAt])
}

// One step of the delivery process. The process is identical for every project,
// so these are defined once and every project inherits the whole list.
model ProcessTask {
  id         String    @id @default(cuid())
  name       String
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  order      Int       @default(0)

  // The part of the process this step belongs to — Site & Procurement, 3D
  // Visualization, Technical Drawings. Sections are what the board groups by
  // and what work is handed out in: a person takes a section of a project, not
  // sixteen separate steps.
  sectionId String?
  section   ProcessSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  // What this kind of work needs, written once instead of on every project.
  //
  // A step is the same job whatever project it sits on, so the standard belongs
  // here and a cell of the board only has to say where it differs — lib/
  // task-types.ts decides which applies. Before this, "what counts as done" was
  // typed per cell, which in practice meant it was usually not typed at all,
  // and a submission can only be checked against something somebody wrote.
  deliverable   String? @db.Text
  acceptance    String? @db.Text
  estimateHours Float?
  // What proof to send back, and the checks to run through while doing it.
  evidence  String? @db.Text
  checklist String? @db.Text

  // Whether work of this kind may be settled without a person looking. Refused
  // outright when no acceptance criteria are written, however this is set:
  // accepting with nothing to check against is the one setting here that could
  // do real damage quietly (`mayAutoAccept` in lib/task-types.ts).
  autoAccept Boolean @default(false)

  // Who normally reviews this step, where that is not the manager.
  reviewerId String?
  reviewer   Employee? @relation("StepReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  periodsFrom StagePeriod[] @relation("PeriodFrom")
  periodsTo   StagePeriod[] @relation("PeriodTo")

  createdAt DateTime @default(now())

  entries ProjectTaskEntry[]
}

// The state of one process task on one project — a single cell of the board.
// Rows are created lazily: an untouched cell simply has no entry and reads TODO.
model ProjectTaskEntry {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String
  task      ProcessTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  state       TaskState @default(TODO)
  completedAt DateTime?
  startedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // An entry is normally worked by whoever owns the step; assigning one here
  // overrides that for this project without moving the whole column.
  assigneeId String?
  assignee   Employee? @relation("EntryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Scheduling and detail the employee portal needs. A day, not a timestamp:
  // "which day is this on" is a calendar question in the company timezone.
  scheduledFor DateTime?    @db.Date
  dueAt        DateTime?
  priority     TaskPriority @default(MEDIUM)
  adminNote    String?      @db.Text
  employeeNote String?      @db.Text

  // Some cells are not this person's score to keep: a step that turned out not
  // to apply to the project, or one somebody else absorbed. Excluded cells
  // still sit on the board and can still be ticked; they simply do not count
  // towards anyone's completion percentage.
  excludedFromProgress Boolean @default(false)

  // What finishing this actually means, and what it costs. Written by the
  // manager (or proposed by the assistant) so that "done" is checkable rather
  // than a matter of opinion, and so the day's work can be weighed as well as
  // counted.
  deliverable   String? @db.Text
  acceptance    String? @db.Text
  estimateHours Float?

  // Why it cannot move, and who can unstick it. Set means blocked; cleared
  // means it is running again — no extra state on the board.
  blockedReason String?   @db.Text
  blockedById   String?
  blockedBy     Employee? @relation("EntryBlockedBy", fields: [blockedById], references: [id], onDelete: SetNull)

  // The last thing anyone said about it, and what happens next: what a
  // follow-up asks for and what a summary reads back.
  lastUpdateNote String?   @db.Text
  lastUpdateAt   DateTime?
  nextStep       String?

  notifications Notification[]
  submissions   TaskSubmission[]
  stateChanges  TaskStateChange[]
  waitsFor      TaskDependency[] @relation("DependentEntry")
  blocks        TaskDependency[] @relation("BlockingEntry")

  @@unique([projectId, taskId])
  @@index([taskId])
  @@index([assigneeId])
  @@index([scheduledFor])
  @@index([blockedById])
}

// One task waiting on another: the drawings wait on the design being approved.
//
// Between board cells rather than between steps, because the answer differs per
// project: the same two steps run in parallel on one job and in sequence on the
// next. Nothing here is a state — whether a task is "ready" is read off these
// rows (lib/task-readiness.ts), so the board keeps the states it has.
model TaskDependency {
  id String @id @default(cuid())

  /// The task that waits.
  entryId String
  entry   ProjectTaskEntry @relation("DependentEntry", fields: [entryId], references: [id], onDelete: Cascade)

  /// The task it waits for.
  dependsOnEntryId String
  dependsOn        ProjectTaskEntry @relation("BlockingEntry", fields: [dependsOnEntryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([entryId, dependsOnEntryId])
  @@index([dependsOnEntryId])
}

// A day proposed for one person, kept rather than held on a screen.
//
// A proposal is worth nothing if it vanishes when the manager navigates away:
// they generate it, look at the board, come back, adjust it, and only then put
// it on the day. So it is stored, one per person per day, and editing it is
// just writing it again. `appliedAt` records that it has been put on the
// board; the plan stays afterwards, as the record of what was decided.
model DayPlan {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // The day being planned, in the company timezone, like every other day column.
  day DateTime @db.Date

  // The blocks, as proposed and then as the manager edited them. JSON because
  // a block is only ever read and written whole, and its shape belongs to
  // lib/day-plan.ts rather than to the database.
  blocks Json

  // Anything the model said that was not a block, kept rather than dropped.
  notes String? @db.Text

  appliedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@unique([employeeId, day])
}

// A question the platform owes somebody about their planned day, and the
// answer when it comes.
//
// Nothing here could ask anything at a particular moment before this table:
// there was no queue, no scheduled work of any kind, and the only timed job ran
// once an hour over deadlines. A row is written when a plan is put on a day,
// and a poller sends whatever has come due.
//
// `dedupeKey` is what makes that poller safe to run as often as we like: it is
// derived from the event (who, which day, which block, at what time), never
// from the clock, so running twice asks once — and a block that moves earns a
// new key, because it is a new question about a new time.
model ScheduledFollowUp {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // The day being asked about, in the company timezone.
  day DateTime @db.Date

  // Which question: day-start, block-start, block-middle, block-end, day-end.
  kind String
  // Which block of that day's plan, and what it points at on the board. All
  // null for a question about the day as a whole.
  blockIndex Int?
  entryId    String?
  jobId      String?

  // The instant it becomes askable, already moved out of lunch and out of the
  // evening by lib/follow-ups.ts before it was written.
  dueAt  DateTime
  askedAt DateTime?

  // Closed without asking: by the time it came due the work was already
  // finished, or no longer existed. Nobody received it, so it stays out of
  // askedAt — which the day board counts as asked and unanswered — and the
  // sender never looks at it again.
  skippedAt      DateTime?
  skippedBecause String?

  // What the employee said, and when. Nothing assumes an unanswered question
  // means the work did not happen.
  answeredAt DateTime?
  answer     String?
  answerNote String?   @db.Text

  dedupeKey String @unique
  attempts  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([dueAt, askedAt])
  @@index([employeeId, day])
}

// A rule the studio sets for itself: when to ask, when to tell, when to
// escalate.
//
// Every rule produces speech and nothing else — a question to the person, a
// note to the manager, an escalation when something has gone on too long. There
// is deliberately no action here that moves, ticks or approves work:
// `mayMoveWork()` in lib/automation.ts says so in one place rather than leaving
// it to be inferred from the absence of a case.
model AutomationRule {
  id   String @id @default(cuid())
  name String

  // Read off the manager's day board rather than defined again here: no-plan,
  // overloaded, blocked, contradiction, waiting-on-manager, unanswered.
  trigger String
  atLeast Int    @default(1)

  // ask | tell | escalate, and who hears it.
  action    String @default("ask")
  recipient String @default("the-person")

  graceMinutes         Int  @default(0)
  cooldownMinutes      Int  @default(0)
  escalateAfterMinutes Int?

  // Off until somebody turns it on, and the AppSetting `automation_enabled`
  // stops every one of them at once. A feature that talks to people on its own
  // is not born switched on.
  enabled Boolean @default(false)
  order   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  states AutomationState[]
}

// What a rule remembers about one person on one day: when its condition was
// first seen to be true, and when it last actually said something.
//
// Both are recorded moments rather than anything worked out from the clock,
// which is what makes grace and cooldown mean the same thing whether the runner
// runs twice a minute or wakes up an hour late.
model AutomationState {
  id String @id @default(cuid())

  ruleId String
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  day DateTime @db.Date

  since       DateTime?
  lastActedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([ruleId, employeeId, day])
  @@index([employeeId, day])
}

// One employee's account of their own day, in their own words, for the manager.
//
// The other half of the day's record. Everything else the platform holds about
// a day is inferred — a state that moved, a question answered with a tap, a
// photo checked against criteria. This is the part only the person who did the
// work can supply: what actually happened, including the parts no field has a
// column for.
//
// One row per person per day, so writing again during the day edits the same
// report rather than stacking notes. That matters for reading it: a manager
// wants one account of Tuesday, not seven fragments of it.
model DailyReport {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// The day it is about, in the company timezone.
  day DateTime @db.Date

  text String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([employeeId, day])
  @@index([day])
}

// Every time a task changed state: what it was, what it became, who did it and
// why.
//
// Until this table there was no record at all. The manager ticking a cell on
// the board left nothing behind — not who, not when, not from what — so a
// question like "when did this actually start" had no answer anywhere, and an
// automatic change could not be told apart from a person's.
//
// Rows are never edited. A wrong change is corrected by another change, and
// both stay.
model TaskStateChange {
  id String @id @default(cuid())

  // Exactly one of the two: a cell of the project board, or a week-board job.
  entryId String?
  entry   ProjectTaskEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)

  assignedTaskId String?
  job            AssignedTask? @relation(fields: [assignedTaskId], references: [id], onDelete: Cascade)

  fromState TaskState
  toState   TaskState

  // Who made the claim: employee, manager, or system. The employee is named
  // where there is one; the manager is a single shared account, so there is no
  // id to record for them.
  actorType       String
  actorEmployeeId String?

  // Why, where anybody said — a review note, a reason for reopening.
  reason String? @db.Text

  // Whether a job made this change rather than a person. Nothing automatic may
  // reach DONE, but the column is here so the difference is always visible.
  automatic Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([entryId, createdAt])
  @@index([assignedTaskId, createdAt])
}

// One notification for one employee. Everything an employee is told goes
// through here first, so the in-app centre and push are always consistent.
model Notification {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String           @db.Text

  entryId String?
  entry   ProjectTaskEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  // Where a click should land, resolved when the notification is created so
  // the service worker never has to know the routing rules.
  url      String?
  metadata Json?

  // Deterministic per logical event, so a job that runs twice writes once.
  dedupeKey String @unique

  readAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@index([employeeId, readAt])
  @@index([employeeId, createdAt])
}

// Per-employee switches the engine consults before sending anything.
model NotificationPreference {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  pushEnabled         Boolean @default(true)
  chatMessages        Boolean @default(true)
  taskAssigned        Boolean @default(true)
  taskUpdated         Boolean @default(true)
  todaySchedule       Boolean @default(true)
  tomorrowSchedule    Boolean @default(true)
  deadlineReminders   Boolean @default(true)
  // How far ahead of dueAt a reminder fires — configurable, not hardcoded.
  deadlineLeadMinutes Int     @default(120)

  updatedAt DateTime @default(now()) @updatedAt
}

// One row per device an employee has enabled push on.
model PushSubscription {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  endpoint     String  @unique
  p256dh       String
  auth         String
  userAgent    String?
  // Deactivated rather than deleted when the push service rejects it, so the
  // delivery log still points at something.
  active       Boolean @default(true)
  failureCount Int     @default(0)

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  deliveries NotificationDelivery[]

  @@index([employeeId, active])
}

// Delivery attempts, kept so push failures are debuggable after the fact.
model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   PushSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  channel DeliveryChannel
  status  DeliveryStatus
  detail  String?

  createdAt DateTime @default(now())

  @@index([notificationId])
}

// Small key/value store for platform settings such as the company timezone.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// The team conversation. One channel today — the whole team plus the manager —
// but modelled as a channel so a second one (per project, say) needs no
// migration later.
model ChatChannel {
  id   String @id @default(cuid())
  key  String @unique
  name String

  createdAt DateTime @default(now())

  messages ChatMessage[]
  reads    ChatRead[]
  tasks    ChatTask[]
  calls    Call[]
  meetings ChatMeeting[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  authorType ChatAuthorType
  // Set for employee messages; the manager and the agent have no Employee row.
  authorId   String?
  author     Employee?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String

  kind ChatMessageKind @default(TEXT)
  body String?         @db.Text

  attachmentUrl   String?
  attachmentName  String?
  attachmentType  String?
  attachmentSize  Int?
  // Voice notes only, so the player can show a length before loading.
  durationSeconds Int?

  // Optional context: which project this message is about.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // The assistant is the manager's tool, so its questions and answers stay out
  // of the team's view entirely rather than being hidden in the client.
  managerOnly Boolean @default(false)

  // The card, when this message is a task.
  task ChatTask?
  // The call, when this message is the line a call left behind.
  call Call?
  // The card, when this message is a meeting.
  meeting ChatMeeting?

  createdAt DateTime @default(now())

  @@index([channelId, createdAt])
  @@index([channelId, managerOnly, createdAt])
}

// How far each person has read, for the unread badge.
model ChatRead {
  id        String      @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // The employee id, or "admin" for the manager, who has no Employee row.
  // A plain string rather than a nullable id because Postgres treats NULLs as
  // distinct — a nullable column in this unique would let duplicate rows
  // accumulate, and Prisma cannot address a null through a compound unique.
  readerKey String

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  lastReadAt DateTime @default(now())

  @@unique([channelId, readerKey])
}

// An employee asking for something to be bought for the office. The manager
// decides; nothing is ordered on an employee's say-so.
model SupplyRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  item          String
  quantity      String?
  note          String? @db.Text
  estimatedCost Float?
  urgent        Boolean @default(false)

  status       SupplyRequestStatus @default(PENDING)
  decisionNote String?
  decidedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([employeeId, createdAt])
}

// A receipt photo an employee spent their own money on ("salary++"). The
// amount the receipt shows and the amount that counts are stored separately:
// the company rule caps any single receipt at 2 JOD, and keeping the original
// means a disputed total can always be traced back to what was actually paid.
model ExpenseReceipt {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  imageUrl String
  status   ReceiptStatus @default(PENDING)

  // Filled in by the vision pass, and editable by the manager afterwards.
  vendor        String?
  receiptDate   DateTime?
  rawAmount     Float?
  countedAmount Float?
  currency      String    @default("JOD")
  summary       String?   @db.Text
  aiNotes       String?   @db.Text

  // The payroll month this belongs to, as YYYY-MM in the company timezone.
  periodMonth String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([employeeId, periodMonth])
  @@index([periodMonth, status])
}

// One day's lateness for one employee. Entered by the manager today; the
// attendance device can write the same rows later without changing anything
// downstream.
model AttendanceRecord {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  day        DateTime @db.Date
  delayHours Float    @default(0)
  note       String?
  // MANUAL for now; DEVICE once the attendance machine feeds this table.
  source     String   @default("MANUAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([employeeId, day])
  @@index([day])
}

// An employee's evidence that a task is done, and what the manager decided
// about it. Kept as rows rather than fields on the task so a rejected attempt
// and the resubmission that followed are both still there to look at.
model TaskSubmission {
  id      String            @id @default(cuid())
  entryId String?
  entry   ProjectTaskEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)

  // Or a job the manager handed out by hand. Exactly one of the two is set:
  // evidence is always for something, and the review has to know what it is
  // approving.
  assignedTaskId String?
  assignedTask   AssignedTask? @relation(fields: [assignedTaskId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // The proof itself — a photo of the work, or a screenshot.
  imageUrl String
  note     String? @db.Text

  status     SubmissionStatus @default(PENDING)
  reviewNote String?          @db.Text
  reviewedAt DateTime?

  // What the check made of it, and when it was checked. Separate from `status`
  // on purpose: the check is an opinion with reasons behind it, while the
  // status is what a person decided. A check never writes the status.
  outcome   String?
  checkedAt DateTime?
  checks    SubmissionCheck[]

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([entryId, createdAt])
  @@index([assignedTaskId, createdAt])
}

// One thing that was asked for, and what the evidence said about it.
//
// A submission is checked criterion by criterion rather than as a whole, so
// what comes back to the employee is the specific thing to fix rather than
// "the work is incomplete" — and so the manager can see what the check
// actually looked at before trusting it.
//
// The verdict is a string, like the other small vocabularies in this schema:
// its five values live in lib/verification.ts, where they are tested. The one
// that matters most is `cannot-tell`, which says the evidence does not settle
// the question — never that the work was not done.
model SubmissionCheck {
  id           String         @id @default(cuid())
  submissionId String
  submission   TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // What was asked, in the manager's own words, as it stood when the work was
  // handed in. Kept here rather than read live: changing the criteria later
  // must not silently change what somebody was judged against.
  required String  @db.Text
  evidence String? @db.Text
  verdict  String
  gap      String? @db.Text

  createdAt DateTime @default(now())

  @@index([submissionId, createdAt])
}

// The manager's own notification feed.
//
// Employees have Notification; this is the other direction — work coming back
// up. It is deliberately a separate table: there is one manager, no devices to
// fan out to and no preferences to consult, so none of the employee engine's
// machinery applies. The unique dedupeKey gives it the same idempotency.
model AdminNotification {
  id      String                @id @default(cuid())
  type    AdminNotificationType
  title   String
  message String                @db.Text
  url     String

  entryId    String?
  employeeId String?
  employee   Employee? @relation("AdminNotificationSubject", fields: [employeeId], references: [id], onDelete: SetNull)

  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
}

// A change to what someone is paid this period, with the reason attached.
//
// Amounts are signed the way payroll reads them: positive is money off. One row
// per employee per period per kind, so a monthly job that runs twice does not
// deduct twice.
model SalaryAdjustment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // "2026-09" for a month, "2026-W37" for a week.
  periodKey String
  kind      String
  amount    Float
  reason    String @db.Text

  createdAt DateTime @default(now())

  @@unique([employeeId, periodKey, kind])
  @@index([periodKey])
}

// A part of the delivery process, and the unit work is handed out in.
model ProcessSection {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)
  color String @default("cyan")

  createdAt DateTime @default(now())

  tasks       ProcessTask[]
  assignments ProjectSectionAssignment[]
}

// How long a run of steps is allowed to take.
//
// Deliberately a range rather than a number per step: nobody times a process
// one box at a time. "Site visit through BOQ is four days" is one decision, and
// every step inside the range shares the deadline it produces. Ranges chain —
// the next one starts when this one is finished — so the whole process has
// dates without anyone typing a date.
model StagePeriod {
  id String @id @default(cuid())

  fromTaskId String
  fromTask   ProcessTask @relation("PeriodFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTaskId   String
  toTask     ProcessTask @relation("PeriodTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  days Int

  createdAt DateTime @default(now())

  @@unique([fromTaskId, toTaskId])
}

// Who does a section of one project. The same section goes to different people
// on different jobs, which is why this hangs off the pair rather than off the
// section alone.
model ProjectSectionAssignment {
  id String @id @default(cuid())

  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId String
  section   ProcessSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([projectId, sectionId])
  @@index([employeeId])
}

// Work the manager hands out directly, outside the project process.
//
// "Go and negotiate with the supplier, two days" is not a stage of any project
// and has no cell on the board — it is a job for a person over a span of days,
// which is what the week view shows.
model AssignedTask {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title String
  note  String? @db.Text

  // Days, not timestamps: "Tuesday to Wednesday" is a calendar question in the
  // company timezone.
  startDay DateTime @db.Date
  endDay   DateTime @db.Date

  state       TaskState    @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  completedAt DateTime?

  // The same detail a board cell carries, for the jobs handed out by hand.
  deliverable   String? @db.Text
  acceptance    String? @db.Text
  estimateHours Float?

  blockedReason String?   @db.Text
  blockedById   String?
  blockedBy     Employee? @relation("JobBlockedBy", fields: [blockedById], references: [id], onDelete: SetNull)

  lastUpdateNote String?   @db.Text
  lastUpdateAt   DateTime?
  nextStep       String?

  submissions TaskSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  stateChanges TaskStateChange[]

  // Handed out from a chat, as one person's part of a task card there. The card
  // carries the exact moment it is due; these days are the calendar span of it.
  chatTaskId String?
  chatTask   ChatTask? @relation(fields: [chatTaskId], references: [id], onDelete: Cascade)

  @@index([employeeId, startDay])
  @@index([startDay, endDay])
  @@index([chatTaskId])
}

// A task the manager hands out from a conversation, shown there as a card.
//
// Not a new kind of work: each person it is given to gets an ordinary
// AssignedTask, with the same states, the same photo proof and the same review
// as a job from the week board. The card is what they share: the title, the
// moment it is due, and the thread of comments under it.
model ChatTask {
  id String @id @default(cuid())

  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // The message the card sits in. Deleting it deletes the task, with every
  // person's part of it.
  messageId String      @unique
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  title       String
  description String?      @db.Text
  // A moment, not a day: "by 3 PM" is what a task in a chat says.
  dueAt       DateTime
  priority    TaskPriority @default(MEDIUM)

  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?

  assignments AssignedTask[]
  comments    ChatTaskComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([channelId, createdAt])
  @@index([dueAt])
}

// The thread under a task card, written by the manager and the people the task
// was given to.
model ChatTaskComment {
  id String @id @default(cuid())

  chatTaskId String
  chatTask   ChatTask @relation(fields: [chatTaskId], references: [id], onDelete: Cascade)

  authorType ChatAuthorType
  // Set for employees; the manager has no Employee row.
  authorId   String?
  authorName String
  body       String         @db.Text

  createdAt DateTime @default(now())

  @@index([chatTaskId, createdAt])
}

// A meeting the manager sets from a conversation, shown there as a card.
//
// It holds no call of its own. An online meeting's card carries a Join button
// that starts — or joins — an ordinary Call in the same conversation when
// somebody presses it, because a call started by a scheduled job with no
// browser behind it ends itself within seconds and is written down as missed.
// So the platform says the moment has come; a person opens the call.
model ChatMeeting {
  id String @id @default(cuid())

  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // The message the card sits in. Deleting it calls the meeting off, with
  // everybody's answer.
  messageId String      @unique
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  title  String
  agenda String?     @db.Text
  mode   MeetingMode @default(ONLINE)
  // Where an in-person meeting is. An online one carries no place.
  place  String?

  // A moment, not a day — the same distinction ChatTask.dueAt draws.
  startsAt        DateTime
  durationMinutes Int      @default(30)
  // How long before it starts everybody is told. 0 means only at the time.
  remindMinutes   Int      @default(10)

  attendees ChatMeetingAttendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([channelId, createdAt])
  @@index([startsAt])
}

// One person asked to a meeting, and what they answered.
//
// Keyed the way a call's participants and a chat's read marks are: "admin" for
// the manager, who has no Employee row, and the employee id otherwise. A plain
// string rather than a relation, exactly as CallParticipant does it.
model ChatMeetingAttendee {
  id String @id @default(cuid())

  meetingId String
  meeting   ChatMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  memberKey String
  name      String
  color     String?

  rsvp        MeetingRsvp @default(INVITED)
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([meetingId, memberKey])
}

// A call in a conversation, audio or video, between the people in it.
//
// The sound and pictures go straight between their devices (WebRTC). This is
// only the meeting point: who was asked, who is in it, and — in CallSignal —
// the offers, answers and network addresses their devices trade to find each
// other. When it ends it leaves a line in the conversation.
model Call {
  id String @id @default(cuid())

  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  kind   CallKind
  status CallStatus @default(RINGING)

  // "admin" for the manager, the employee id otherwise: the key chat reads use.
  startedByKey  String
  startedByName String

  createdAt  DateTime  @default(now())
  answeredAt DateTime?
  endedAt    DateTime?
  // "completed", "missed" or "declined", once it has ended.
  endReason  String?

  // The line it left in the conversation.
  messageId String?      @unique
  message   ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  participants CallParticipant[]
  signals      CallSignal[]

  @@index([channelId, status])
  @@index([status, createdAt])
}

// One person's place in a call: asked, in it, gone, or said no.
model CallParticipant {
  id String @id @default(cuid())

  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  memberKey String
  name      String
  color     String?

  state      CallParticipantState @default(INVITED)
  joinedAt   DateTime?
  leftAt     DateTime?
  // When their open call last showed it was still there. A closed tab or a
  // phone that lost its signal stops this, and they are counted as gone.
  lastSeenAt DateTime?

  @@unique([callId, memberKey])
  @@index([memberKey, state])
}

// What one device in a call sends another to connect: a session description
// or a batch of network candidates. Read in id order; deleted when the call ends.
model CallSignal {
  id Int @id @default(autoincrement())

  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  fromKey String
  toKey   String
  // "description" or "candidates".
  type    String
  payload Json

  createdAt DateTime @default(now())

  @@index([toKey, id])
  @@index([callId])
}
